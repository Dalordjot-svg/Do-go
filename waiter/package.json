{
  "name": "coffeeman-waiter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:emulator": "firebase emulators:exec --config firebase.json --only database --project demo-coffeeman 'vitest run tests/firebase.test.ts'",
    "emulator": "firebase emulators:start --config firebase.json --only database --project demo-coffeeman",
    "test:emulator:e2e": "firebase emulators:exec --config firebase.json --only database --project demo-coffeeman 'playwright test --config playwright.emulator.config.ts'",
    "build:pages": "npm run build && node scripts/stage-pages.mjs",
    "test:mobile": "playwright test --config playwright.mobile.config.ts"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "firebase": "^12.0.0",
    "lucide-react": "^0.525.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
